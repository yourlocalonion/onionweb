		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=Kanit:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Noto+Sans:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
	</head>
	<body class="bg-zinc-900 p-4">
		<p class="font-dmmono text-green-300 text-center text-2xl mt-4">[0]</p>
		<p class="font-dmmono text-green-300 text-center text-4xl mt-4 w-16" id="word">aaaaaaaaaaaaaaaaaaaaaaaaa</p>
		<script>
			const queryString = window.location.search;
			const urlParams = new URLSearchParams(queryString);
			const p = document.getElementById("word");

			const encrypted = urlParams.get('encrypted')
			const finalText = encrypted;
			
			const characters = "!@#$%^&*()_+-=<>?/|}{[]~";

			let current = Array(finalText.length).fill("-");
			let interval = 20; // milliseconds per character scramble step
			let steps = 4;    // number of steps before locking in the final character

			let frame = 0;

			function decryptStep() {
			  let output = "";

			  for (let i = 0; i < finalText.length; i++) {
			    if (frame >= i * steps) {
			      if (frame >= (i + 1) * steps) {
			        output += finalText[i]; // Lock in final letter
			      } else {
			        output += characters[Math.floor(Math.random() * characters.length)];
			      }
			    } else {
			      output += current[i];
			    }
			  }

			  p.textContent = output;

			  frame++;
			  if (frame <= (finalText.length + 1) * steps) {
			    setTimeout(decryptStep, interval);
			  }
			}

			decryptStep();
		</script>
	</body>
</html>
