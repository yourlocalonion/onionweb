<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#d9cc9c" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="keywords" content="yourlocalonion">

		<meta content="onion-web" property="og:title" />
		<meta content="main-node" property="og:description" />

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inconsolata:wght@200..900&display=swap" rel="stylesheet">

		<title>main-node</title>
	</head>
	<body class="bg-zinc-950 text-zinc-100 p-4 font-inconsolata">
		<p id="log">
			INFO: connecting to cluster: "onion-web" (ONWB) ... <br>
			INFO: connection established (200) <br>
			INFO: attempting persistent neural latch ... <br>
			WARN: clienthost requesting vis-int from cbrl-int while busy! <br>
			INFO: preparing visual interface ... <br>
			ERROR: vis-int undefined (cannot find index-vis) <br>
			WARN: auto-response: "under renovation, try again soon." <br>
			INFO: visual interface "index" uninitialized or private, run "vis-fallback" for legacy-vis. <br>
		</p>
		<div id="cons-input-area">
			<p class="inline-block">></p>
			<input autofocus id="cons-input" class="bg-zinc-950 font-inconsolata w-full max-w-xs outline-none focus:outline-none">
		</div>
	</body>
	<script>
		// hi devtoolers
		let consoleInput = document.getElementById("cons-input") as HTMLInputElement
		let consoleInputArea = document.getElementById("cons-input-area") 
		let log = document.getElementById("log")

		function logText(text) {
			log.innerText += text
			log.innerHTML += '<br>'
		}

		function sleep(ms) {
  			return new Promise(resolve => setTimeout(resolve, ms));
		}

		function toggleInput(toggle) {
			if (toggle) {
				consoleInputArea.className = ""
				console.log("showing input")
			} else {
				consoleInputArea.className = "hidden"
				console.log("hiding input")
			}
		}

		function getRandomInt(min, max) {
  			return Math.floor(Math.random() * (max - min)) + min;
		}
		
		async function eastereggWubby() {
			toggleInput(false)
			logText("INFO: attempting connection to wubby-proxy ...")
			await sleep(Math.floor(Math.random() * 4000))
			logText("INFO: connection established.")
						
			await sleep(2000)
			logText("INFO: fetching hub data ...")
			await sleep(getRandomInt(0, 1000))
			logText("INFO: queried " + getRandomInt(0, 100) + " worlds.")
			await sleep(getRandomInt(0, 4000))
			logText("INFO: queried " + getRandomInt(100, 500) + " worlds.")
			await sleep(getRandomInt(2000, 6000))
			logText("INFO: queried " + getRandomInt(500, 1000) + " worlds.")
			await sleep(getRandomInt(1000, 3000))
			logText("INFO: queried " + getRandomInt(1000, 2000) + " worlds.")
			await sleep(getRandomInt(1000, 4000))
			logText("INFO: queried " + getRandomInt(2000, 7000) + " worlds.")
			await sleep(getRandomInt(1000, 4000))
			logText("WARN: auto-response: \"congrats you found an \"easter egg\"\"")
			logText("ERROR: connection severed.")
			await sleep(getRandomInt(1000, 4000))

			toggleInput(true)
		}

		consoleInput.addEventListener('keyup', (event) =>{
			if (event.key == 'Enter') {
				switch(consoleInput.value) {
					case "vis-fallback":
						logText('> ' + consoleInput.value)
						logText('interfacing clienthost to legacy-vis ...')
						toggleInput(false)
						window.location.href = "legacy"
						consoleInput.value = ""

						break
					case "wubby":
						logText('> ' + consoleInput.value)
						eastereggWubby()
						consoleInput.value = ""

						break
					case "clr":
					case "clear":
						log.innerHTML = ""
						consoleInput.value = ""

						break
					case "barralake": 
						logText('> ' + consoleInput.value)
						logText('interfacing clienthost to external cluster ...')
						toggleInput(false)
						window.location.href = "https://barralake.de/"
						consoleInput.value = ""

						break
					default:
						logText('> ' + consoleInput.value)
						logText("ERROR: unimplemented command '" + consoleInput.value + "'.")
						consoleInput.value = ""

						break
				}
			}
		})
	</script>
</html>
